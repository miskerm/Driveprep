# ---------------------------------------------------------------------------
# Database (Turso / libSQL)
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ---------------------------------------------------------------------------
# Auth.js / NextAuth
# Generate a secret with: openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET=replace-with-a-long-random-secret
# Set to true when running behind a trusted reverse proxy / platform.
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Admin account (seeded automatically on first server start)
# Never commit real values. Public signup can never create an admin.
# ---------------------------------------------------------------------------
ADMIN_NAME=DrivoPrep Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# ---------------------------------------------------------------------------
# Manual payment instructions shown to learners after signup
# ---------------------------------------------------------------------------
PAYMENT_AMOUNT=1000
PAYMENT_CURRENCY=ETB
PAYMENT_BANK_NAME=Your bank name
PAYMENT_ACCOUNT_NAME=Account holder name
PAYMENT_ACCOUNT_NUMBER=Your account number
PAYMENT_REFERENCE_NOTE=Use your full name and account email/phone as the payment reference.

# ---------------------------------------------------------------------------
# Telegram bot used to receive payment screenshots
# The bot must be able to send messages to TELEGRAM_CHAT_ID.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id
